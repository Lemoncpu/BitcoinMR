<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.example</groupId>
  <artifactId>BitcoinMR</artifactId>
  <version>1.0-SNAPSHOT</version>
  <properties>
    <maven.compiler.source>8</maven.compiler.source>
    <maven.compiler.target>8</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.debug>true</maven.compiler.debug>
    <maven.compiler.debuglevel>lines,vars,source</maven.compiler.debuglevel>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.apache.hbase</groupId>
      <artifactId>hbase-shaded-client</artifactId>
      <version>2.4.17</version>
    </dependency>
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-common</artifactId>
      <version>3.3.6</version>
    </dependency>
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-mapreduce-client-core</artifactId>
      <version>3.3.6</version>
    </dependency>
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-mapreduce-client-jobclient</artifactId>
      <version>3.3.6</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>1.7.36</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.12.7.1</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>2.4</version>
        <executions>
          <execution>
            <id>DirectAverage</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classifier>DirectAverage</classifier>
              <includes>
                <include>org/example/HdfsToHbase*.class</include>
                <include>org/example/DistributedReputation*.class</include>
                <include>org/example/AnalyticsSupport*.class</include>
                <include>org/example/DirectAverage*.class</include>
              </includes>
              <archive>
                <manifest>
                  <mainClass>org.example.DirectAverage</mainClass>
                </manifest>
              </archive>
            </configuration>
          </execution>
          <execution>
            <id>PositiveKatz</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classifier>PositiveKatz</classifier>
              <includes>
                <include>org/example/HdfsToHbase*.class</include>
                <include>org/example/DistributedReputation*.class</include>
                <include>org/example/AnalyticsSupport*.class</include>
                <include>org/example/PositiveKatz*.class</include>
              </includes>
              <archive>
                <manifest>
                  <mainClass>org.example.PositiveKatz</mainClass>
                </manifest>
              </archive>
            </configuration>
          </execution>
          <execution>
            <id>SignedKatz</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classifier>SignedKatz</classifier>
              <includes>
                <include>org/example/HdfsToHbase*.class</include>
                <include>org/example/DistributedReputation*.class</include>
                <include>org/example/AnalyticsSupport*.class</include>
                <include>org/example/SignedKatz*.class</include>
              </includes>
              <archive>
                <manifest>
                  <mainClass>org.example.SignedKatz</mainClass>
                </manifest>
              </archive>
            </configuration>
          </execution>
          <execution>
            <id>ActivityHeatmap</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classifier>ActivityHeatmap</classifier>
              <includes>
                <include>org/example/ActivityHeatmap*.class</include>
                <include>org/example/AnalyticsSupport*.class</include>
              </includes>
              <archive>
                <manifest>
                  <mainClass>org.example.ActivityHeatmap</mainClass>
                </manifest>
              </archive>
            </configuration>
          </execution>
          <execution>
            <id>DirectionalAsymmetry</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classifier>DirectionalAsymmetry</classifier>
              <includes>
                <include>org/example/DirectionalAsymmetry*.class</include>
                <include>org/example/AnalyticsSupport*.class</include>
              </includes>
              <archive>
                <manifest>
                  <mainClass>org.example.DirectionalAsymmetry</mainClass>
                </manifest>
              </archive>
            </configuration>
          </execution>
          <execution>
            <id>ActivityBursts</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classifier>ActivityBursts</classifier>
              <includes>
                <include>org/example/ActivityBursts*.class</include>
                <include>org/example/AnalyticsSupport*.class</include>
              </includes>
              <archive>
                <manifest>
                  <mainClass>org.example.ActivityBursts</mainClass>
                </manifest>
              </archive>
            </configuration>
          </execution>
          <execution>
            <id>CohortActivity</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classifier>CohortActivity</classifier>
              <includes>
                <include>org/example/CohortActivity*.class</include>
                <include>org/example/AnalyticsSupport*.class</include>
                <include>org/example/DistributedReputation*.class</include>
                <include>org/example/HdfsToHbase*.class</include>
              </includes>
              <archive>
                <manifest>
                  <mainClass>org.example.CohortActivity</mainClass>
                </manifest>
              </archive>
            </configuration>
          </execution>
          <execution>
            <id>PathConflicts</id><phase>package</phase><goals><goal>jar</goal></goals>
            <configuration>
              <classifier>PathConflicts</classifier>
              <includes>
                <include>org/example/PathConflicts*.class</include>
                <include>org/example/AnalyticsSupport*.class</include>
              </includes>
              <archive><manifest><mainClass>org.example.PathConflicts</mainClass></manifest></archive>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
